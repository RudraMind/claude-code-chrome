{
  "manifest_version": 3,
  "name": "Claude Code Workspace",
  "version": "1.0.0",
  "description": "Use Claude Code directly from Chrome. Persistent sessions, folder picker, instant reconnect.",
  "permissions": [
    "nativeMessaging",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "side-panel/panel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Claude Code Workspace",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
